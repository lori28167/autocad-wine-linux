+static NTSTATUS regf_load_key( const struct regf_hive *hive, DWORD nk_offset, HANDLE key, int depth );
+
+static NTSTATUS regf_load_subkey( const struct regf_hive *hive, DWORD nk_offset, HANDLE parent, int depth )
+{
+    const BYTE *nk;
+    DWORD len, name_len;
+    UNICODE_STRING nameW;
+    OBJECT_ATTRIBUTES attr;
+    HANDLE subkey;
+    WCHAR *name;
+    NTSTATUS status;
+
+    if (!(nk = regf_cell( hive, nk_offset, &len )) || len < 0x4c || nk[0] != 'n' || nk[1] != 'k')
+        return STATUS_REGISTRY_CORRUPT;
+    name_len = *(const WORD *)(nk + 0x48);
+    if (name_len > len - 0x4c) return STATUS_REGISTRY_CORRUPT;
+    if (!(name = regf_name( nk + 0x4c, name_len, *(const WORD *)(nk + 2) & 0x20 ))) return STATUS_NO_MEMORY;
 
-    *result = (HKEY)0xdeadbeef;
-    return ERROR_SUCCESS;
+    RtlInitUnicodeString( &nameW, name );
+    InitializeObjectAttributes( &attr, &nameW, 0, parent, NULL );
+    status = NtCreateKey( &subkey, KEY_ALL_ACCESS, &attr, 0, NULL, REG_OPTION_VOLATILE, NULL );
+    HeapFree( GetProcessHeap(), 0, name );
+    if (status) return status;
+    status = regf_load_key( hive, nk_offset, subkey, depth + 1 );
+    NtClose( subkey );
+    return status;
+}
+
+static NTSTATUS regf_load_subkey_list( const struct regf_hive *hive, DWORD list_offset, HANDLE key, int depth )
+{
+    const BYTE *list;
+    DWORD len, count, i, stride;
+    NTSTATUS status;
+
+    if (!(list = regf_cell( hive, list_offset, &len )) || len < 4) return STATUS_REGISTRY_CORRUPT;
+    count = *(const WORD *)(list + 2);
+
+    if ((list[0] == 'l' && (list[1] == 'f' || list[1] == 'h')) || (list[0] == 'l' && list[1] == 'i') ||
+        (list[0] == 'r' && list[1] == 'i'))
+    {
+        stride = (list[1] == 'f' || list[1] == 'h') ? 8 : 4;
+        if (len - 4 < count * stride) return STATUS_REGISTRY_CORRUPT;
+        for (i = 0; i < count; i++)
+        {
+            DWORD offset = *(const DWORD *)(list + 4 + i * stride);
+            if (list[0] == 'r') status = regf_load_subkey_list( hive, offset, key, depth + 1 );
+            else status = regf_load_subkey( hive, offset, key, depth );
+            if (status) return status;
+        }
+        return STATUS_SUCCESS;
+    }
+    return STATUS_REGISTRY_CORRUPT;
+}
+
+static NTSTATUS regf_load_key( const struct regf_hive *hive, DWORD nk_offset, HANDLE key, int depth )
+{
+    const BYTE *nk;
+    const DWORD *values;
+    DWORD len, values_len, i, count;
+    NTSTATUS status;
+
+    if (depth > 512) return STATUS_REGISTRY_CORRUPT;
+    if (!(nk = regf_cell( hive, nk_offset, &len )) || len < 0x4c || nk[0] != 'n' || nk[1] != 'k')
+        return STATUS_REGISTRY_CORRUPT;
+
+    if ((count = *(const DWORD *)(nk + 0x24)))
+    {
+        if (!(values = (const DWORD *)regf_cell( hive, *(const DWORD *)(nk + 0x28), &values_len )) ||
+            values_len < count * sizeof(DWORD))
+            return STATUS_REGISTRY_CORRUPT;
+
+        for (i = 0; i < count; i++)
+        {
+            const BYTE *vk;
+            DWORD vk_len, name_len, size, type;
+            UNICODE_STRING nameW;
+            WCHAR *name;
+            BYTE *data;
+
+            if (!(vk = regf_cell( hive, values[i], &vk_len )) || vk_len < 0x14 || vk[0] != 'v' || vk[1] != 'k')
+                return STATUS_REGISTRY_CORRUPT;
+            name_len = *(const WORD *)(vk + 2);
+            if (name_len > vk_len - 0x14) return STATUS_REGISTRY_CORRUPT;
+            size = *(const DWORD *)(vk + 4);
+            type = *(const DWORD *)(vk + 0x0c);
+
+            if (!(name = regf_name( vk + 0x14, name_len, *(const WORD *)(vk + 0x10) & 1 ))) return STATUS_NO_MEMORY;
+            if (size & 0x80000000)
+            {
+                size &= 0x7fffffff;
+                if (size > 4) size = 4;
+                data = HeapAlloc( GetProcessHeap(), 0, 4 );
+                if (data) memcpy( data, vk + 8, 4 );
+            }
+            else data = regf_value_data( hive, size, *(const DWORD *)(vk + 8) );
+
+            if (!data)
+            {
+                HeapFree( GetProcessHeap(), 0, name );
+                return STATUS_REGISTRY_CORRUPT;
+            }
+            RtlInitUnicodeString( &nameW, name );
+            status = NtSetValueKey( key, &nameW, 0, type, data, size );
+            HeapFree( GetProcessHeap(), 0, data );
+            HeapFree( GetProcessHeap(), 0, name );
+            if (status) return status;
+        }
+    }
+
+    if (*(const DWORD *)(nk + 0x14))
+        return regf_load_subkey_list( hive, *(const DWORD *)(nk + 0x1c), key, depth );
+    return STATUS_SUCCESS;
 }
 
