+/* Minimal reader for Windows binary registry hives ("regf"), used to back
+ * RegLoadAppKeyW with a private volatile copy of the hive contents. */
+
+struct regf_hive
+{
+    const BYTE *data;  /* start of the first hbin */
+    SIZE_T      size;
+};
+
+static const BYTE *regf_cell( const struct regf_hive *hive, DWORD offset, DWORD *len )
+{
+    LONG cell_size;
+
+    if (offset == 0xffffffff || offset > hive->size || hive->size - offset < sizeof(LONG)) return NULL;
+    cell_size = *(const LONG *)(hive->data + offset);
+    if (cell_size < 0) cell_size = -cell_size;
+    if ((DWORD)cell_size < sizeof(LONG) || (DWORD)cell_size > hive->size - offset) return NULL;
+    if (len) *len = cell_size - sizeof(LONG);
+    return hive->data + offset + sizeof(LONG);
+}
+
+static WCHAR *regf_name( const BYTE *name, DWORD len, BOOL ascii )
+{
+    WCHAR *ret;
+    DWORD i, count = ascii ? len : len / sizeof(WCHAR);
+
+    if (!(ret = HeapAlloc( GetProcessHeap(), 0, (count + 1) * sizeof(WCHAR) ))) return NULL;
+    if (ascii) for (i = 0; i < count; i++) ret[i] = name[i];
+    else memcpy( ret, name, count * sizeof(WCHAR) );
+    ret[count] = 0;
+    return ret;
+}
+
+static BYTE *regf_value_data( const struct regf_hive *hive, DWORD size, DWORD offset )
+{
+    const BYTE *cell;
+    DWORD len, done, i, count, list_len;
+    BYTE *ret;
+
+    if (!(ret = HeapAlloc( GetProcessHeap(), 0, size ? size : 1 ))) return NULL;
+    if (!(cell = regf_cell( hive, offset, &len ))) goto fail;
+    if (size > 16344 && len >= 8 && cell[0] == 'd' && cell[1] == 'b')
+    {
+        const DWORD *list;
+        count = *(const WORD *)(cell + 2);
+        if (!(list = (const DWORD *)regf_cell( hive, *(const DWORD *)(cell + 4), &list_len ))) goto fail;
+        if (list_len < count * sizeof(DWORD)) goto fail;
+        for (i = done = 0; i < count && done < size; i++)
+        {
+            const BYTE *seg;
+            DWORD seg_len, chunk;
+            if (!(seg = regf_cell( hive, list[i], &seg_len ))) goto fail;
+            chunk = min( min( seg_len, 16344 ), size - done );
+            memcpy( ret + done, seg, chunk );
+            done += chunk;
+        }
+        if (done != size) goto fail;
+        return ret;
+    }
+    if (len < size) goto fail;
+    memcpy( ret, cell, size );
+    return ret;
+fail:
+    HeapFree( GetProcessHeap(), 0, ret );
+    return NULL;
+}
