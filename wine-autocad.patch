+/* services.exe runs in session 0 on Windows; programs such as the Go and .NET
+ * runtimes check this to detect whether they were started as a service */
+static unsigned int get_reported_session_id( const struct process *process )
+{
+    static const WCHAR services_exeW[] = {'\\','s','e','r','v','i','c','e','s','.','e','x','e'};
+    data_size_t len = sizeof(services_exeW);
+
+    if (process->image && process->imagelen >= len &&
+        !memicmp_strW( process->image + (process->imagelen - len) / sizeof(WCHAR), services_exeW, len ))
+        return 0;
+    return process->session_id;
+}
